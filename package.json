{
  "name": "comicmind",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev:frontend": "vite dev",
    "dev": "cross-env NODE_ENV=development node --env-file=.env --import tsx/esm backend/src/server.ts",
    "dev:benchmark": "cross-env NODE_ENV=development BENCHMARK_MODE=true node --env-file=.env --import tsx/esm backend/src/server.ts",
    "build": "tsx script/build.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "test": "vitest run",
    "test:api": "vitest run tests/api",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx/esm backend/src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "perf:install": "pwsh -File script/install-k6.ps1",
    "perf:auth": "node script/run-k6.mjs run performance/k6/auth.load.js",
    "perf:comic-generation": "node script/run-k6.mjs run performance/k6/comic-generation.load.js",
    "perf:fetch-comics": "node script/run-k6.mjs run performance/k6/fetch-comics.load.js",
    "perf:delete-comic": "node script/run-k6.mjs run performance/k6/delete-comic.load.js",
    "perf:all": "npm run perf:auth && npm run perf:comic-generation && npm run perf:fetch-comics && npm run perf:delete-comic",
    "seed:demo": "node --env-file=.env --import tsx/esm script/seed-demo.ts"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.25",
