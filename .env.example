# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/comicmind

# Auth
JWT_SECRET=change-me

# OpenAI
OPENAI_API_KEY=sk-...
# Optional: override the default image model (gpt-image-2)
OPENAI_IMAGE_MODEL=

# Cloudinary (panel image hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (password-reset email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ComicMind <noreply@example.com>
APP_BASE_URL=http://localhost:5000

# ── Generation pipeline (optional) ──────────────────────────────────────
# Leave DATABASE_URL and REDIS_URL empty to run the synchronous path, which
# is how the free-tier deployment runs today.

# Postgres job ledger
DATABASE_URL=

# Redis panel queue
REDIS_URL=

# 'queue' to hand rendering to the worker; anything else stays synchronous
GENERATION_MODE=

# 'true' hosts the worker inside the API, for single-process deployments
WORKER_INLINE=
