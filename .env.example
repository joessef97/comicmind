# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/comicmind

# Auth
JWT_SECRET=change-me

# OpenAI
OPENAI_API_KEY=sk-...
# Optional: override the default image model (gpt-image-2)
OPENAI_IMAGE_MODEL=

# Cloudinary (panel image hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (password-reset email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ComicMind <noreply@example.com>
APP_BASE_URL=http://localhost:5000

# ── Generation pipeline (optional) ──────────────────────────────────────
# The job ledger and the panel queue both live in the MONGODB_URI database
# above, so there is no second service to configure. Leave GENERATION_MODE
# empty to run the synchronous path, which is how the free-tier deployment
# runs today.

# 'queue' to hand rendering to the worker; anything else stays synchronous
GENERATION_MODE=

# 'true' hosts the worker inside the API, for single-process deployments
WORKER_INLINE=

# Worker tuning (all optional, defaults shown)
# PANEL_WORKER_CONCURRENCY=2
# PANEL_WORKER_POLL_MS=500
# PANEL_JOB_ATTEMPTS=3
# PANEL_JOB_BACKOFF_MS=5000
# How long a claimed panel is held before another worker may retry it
# PANEL_VISIBILITY_TIMEOUT_MS=300000
